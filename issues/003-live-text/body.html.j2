{% extends "base.html.j2" %}
{% import "macros.html.j2" as ui %}

{% block title %}{{ issue.title }} · {{ site.name }} #{{ issue.number }}{% endblock %}

{% block masthead_meta %}
<span class="masthead__issue">Issue {{ issue.number }} · {{ issue.published.strftime("%B %-d, %Y") }}</span>
{% endblock %}

{% block head %}
<style>
  /* Demo CSS lives in each issue so building a new issue never changes an old one. */

  /* ---- Mini Mac windows ---- */
  .windows { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .windows--single { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; }
  .win {
    background: var(--nfv-white);
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(5, 28, 44, 0.15), 0 6px 18px rgba(5, 28, 44, 0.1);
  }
  .win__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--nfv-cool-gray-2);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--nfv-cool-gray-9);
  }
  .win__bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--nfv-cool-gray-4); }
  .win__bar span { margin-left: 8px; }
  .win__body { position: relative; padding: 16px 18px 20px; min-height: 11em; }

  /* A photo of a printed page: a slightly tilted sheet on a gray desk. */
  .photo {
    position: relative;
    padding: 18px 14px;
    border-radius: 6px;
    background: var(--nfv-cool-gray-4);
  }
  .paper {
    position: relative;
    z-index: 0; /* highlights sit behind the words */
    padding: 14px 16px 16px;
    background: var(--nfv-white);
    box-shadow: 0 2px 6px rgba(5, 28, 44, 0.25);
    transform: rotate(-2deg);
  }
  .paper__title { margin: 0 0 8px; font-size: 1rem; font-weight: 800; letter-spacing: 0.06em; color: var(--nfv-navy); }
  .paper__line { display: block; font-size: 0.95rem; line-height: 1.7; }
  .paper__line span { position: relative; white-space: nowrap; }
  .paper__line span::before {
    content: "";
    position: absolute;
    inset: -0.05em -0.12em;
    z-index: -1;
    border-radius: 3px;
    background: rgba(106, 178, 226, 0.5);
    transform-origin: left center;
    transform: scaleX(0);
  }

  .doc-text { margin: 0; font-size: 1rem; line-height: 1.6; }
  .doc-text__paste { display: block; max-height: 0; overflow: hidden; }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    vertical-align: -0.2em;
    background: var(--nfv-black);
    animation: blink 1s steps(1) infinite;
  }

  .pointer { position: absolute; width: 1.15em; height: 1.15em; pointer-events: none; }
  /* I-beam text cursor used while selecting */
  .ibeam { position: absolute; width: 0.9em; height: 1.3em; pointer-events: none; transform: translate(-50%, -15%); }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .badge--navy { background: var(--nfv-navy); color: var(--nfv-white); }

  .demo-keys { display: flex; justify-content: center; gap: 14px; margin-top: 24px; font-size: 1.5rem; }
  .demo-keys .key { min-width: 2.2em; height: 2.2em; padding: 0 0.5em; }

  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* ---- Demo 1: copy text out of a photo (10 s loop) ---- */
  .copy-demo { --dur: 10s; }
  .copy-demo .paper__line:nth-of-type(1) span::before { animation: lt-line-1 var(--dur) infinite; }
  .copy-demo .paper__line:nth-of-type(2) span::before { animation: lt-line-2 var(--dur) infinite; }
  .copy-demo .paper__line:nth-of-type(3) span::before { animation: lt-line-3 var(--dur) infinite; }
  .copy-demo .ibeam { left: 0; top: -3.4em; opacity: 0; animation: lt-drag var(--dur) infinite; }
  .copy-demo .copied { position: absolute; right: 28px; top: 26px; opacity: 0; transform: scale(0.8); transform-origin: right center; animation: lt-copied var(--dur) infinite; }
  .copy-demo .doc-text__paste { animation: lt-paste var(--dur) infinite; }
  .copy-demo .paste-spot { position: relative; display: inline-block; }
  .copy-demo .pointer--click { left: 0; top: 0.4em; opacity: 0; animation: lt-click var(--dur) infinite; }
  .copy-demo .press-cmd .key { animation: lt-press-cmd var(--dur) infinite; }
  .copy-demo .press-c .key { animation: lt-press-c var(--dur) infinite; }
  .copy-demo .press-v .key { animation: lt-press-v var(--dur) infinite; }
  .copy-demo .steps li:nth-child(1) { animation: lt-step-1 var(--dur) infinite; }
  .copy-demo .steps li:nth-child(2) { animation: lt-step-2 var(--dur) infinite; }
  .copy-demo .steps li:nth-child(3) { animation: lt-step-3 var(--dur) infinite; }

  @keyframes lt-line-1 { 0%, 10% { transform: scaleX(0); opacity: 1; } 17%, 90% { transform: scaleX(1); opacity: 1; } 95%, 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes lt-line-2 { 0%, 17% { transform: scaleX(0); opacity: 1; } 24%, 90% { transform: scaleX(1); opacity: 1; } 95%, 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes lt-line-3 { 0%, 24% { transform: scaleX(0); opacity: 1; } 31%, 90% { transform: scaleX(1); opacity: 1; } 95%, 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes lt-drag { 0%, 6% { opacity: 0; left: 0; top: -3.4em; } 10% { opacity: 1; left: 0; top: -3.4em; } 31% { opacity: 1; left: 100%; top: 0; } 50% { opacity: 1; left: 100%; top: 0; } 54%, 100% { opacity: 0; left: 100%; top: 0; } }
  @keyframes lt-copied { 0%, 36% { opacity: 0; transform: scale(0.8); } 39%, 52% { opacity: 1; transform: scale(1); } 56%, 100% { opacity: 0; transform: scale(1); } }
  @keyframes lt-click { 0%, 54% { opacity: 0; transform: translate(2.5em, 1.5em); } 59% { opacity: 1; transform: none; } 61% { transform: scale(0.8); } 63% { transform: none; } 90% { opacity: 1; } 94%, 100% { opacity: 0; } }
  @keyframes lt-paste { 0%, 67% { max-height: 0; } 68%, 94% { max-height: 6em; } 95%, 100% { max-height: 0; } }
  @keyframes lt-press-cmd { 0%, 33%, 45%, 63%, 75%, 100% { transform: none; background: var(--nfv-navy); color: var(--nfv-white); } 34%, 44%, 64%, 74% { transform: translateY(0.12em); background: var(--nfv-light-blue); color: var(--nfv-midnight); box-shadow: none; } }
  @keyframes lt-press-c { 0%, 36%, 42%, 100% { transform: none; background: var(--nfv-navy); color: var(--nfv-white); } 37%, 41% { transform: translateY(0.12em); background: var(--nfv-light-blue); color: var(--nfv-midnight); box-shadow: none; } }
  @keyframes lt-press-v { 0%, 66%, 72%, 100% { transform: none; background: var(--nfv-navy); color: var(--nfv-white); } 67%, 71% { transform: translateY(0.12em); background: var(--nfv-light-blue); color: var(--nfv-midnight); box-shadow: none; } }
  @keyframes lt-step-1 { 0%, 7%, 32%, 100% { background: var(--nfv-white); } 9%, 30% { background: var(--nfv-light-blue); } }
  @keyframes lt-step-2 { 0%, 32%, 54%, 100% { background: var(--nfv-white); } 34%, 52% { background: var(--nfv-light-blue); } }
  @keyframes lt-step-3 { 0%, 55%, 95%, 100% { background: var(--nfv-white); } 57%, 93% { background: var(--nfv-light-blue); } }

  /* ---- Demo 2: translate the words in a flyer (9 s loop) ---- */
  .translate-demo { --dur: 9s; }
  .translate-demo .paper__line span::before { animation: tr-select var(--dur) infinite; }
  .translate-demo .win__body { min-height: 17em; }
  .translate-demo .pointer--menu { left: 44%; top: 40%; opacity: 0; animation: tr-pointer var(--dur) infinite; }

  .context-menu {
    position: absolute;
    left: 46%;
    top: 43%;
    z-index: 2;
    min-width: 13.5em;
    padding: 5px;
    border-radius: 8px;
    background: var(--nfv-white);
    box-shadow: 0 0 0 1px rgba(5, 28, 44, 0.12), 0 8px 24px rgba(5, 28, 44, 0.25);
    font-size: 0.8125rem;
    opacity: 0;
    animation: tr-menu var(--dur) infinite;
  }
  .context-menu span { display: block; padding: 4px 10px; border-radius: 5px; white-space: nowrap; }
  .context-menu hr { border: 0; border-top: 1px solid var(--nfv-cool-gray-2); margin: 4px 6px; }
  .context-menu .menu-translate { animation: tr-pick var(--dur) infinite; }

  .translation {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 8px;
    z-index: 2;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--nfv-white);
    box-shadow: 0 0 0 1px rgba(5, 28, 44, 0.12), 0 8px 24px rgba(5, 28, 44, 0.25);
    opacity: 0;
    transform: translateY(8px);
    animation: tr-popover var(--dur) infinite;
  }
  .translation__langs { margin: 0 0 6px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--nfv-cool-gray-9); }
  .translation__text { margin: 0; font-size: 0.95rem; font-weight: 600; line-height: 1.45; }

  .translate-demo .press-ctrl .key { animation: tr-press-ctrl var(--dur) infinite; }
  .translate-demo .steps li:nth-child(1) { animation: tr-step-1 var(--dur) infinite; }
  .translate-demo .steps li:nth-child(2) { animation: tr-step-2 var(--dur) infinite; }
  .translate-demo .steps li:nth-child(3) { animation: tr-step-3 var(--dur) infinite; }

  @keyframes tr-select { 0%, 8% { transform: scaleX(0); opacity: 1; } 16%, 90% { transform: scaleX(1); opacity: 1; } 95%, 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes tr-pointer { 0%, 14% { opacity: 0; transform: translate(1.5em, 1em); } 18%, 34% { opacity: 1; transform: none; } 38%, 100% { opacity: 0; transform: none; } }
  @keyframes tr-menu { 0%, 20% { opacity: 0; transform: translateY(-4px); } 22%, 36% { opacity: 1; transform: none; } 39%, 100% { opacity: 0; transform: none; } }
  @keyframes tr-pick { 0%, 27%, 100% { background: transparent; color: var(--nfv-black); } 29%, 36% { background: var(--nfv-navy); color: var(--nfv-white); } }
  @keyframes tr-popover { 0%, 39% { opacity: 0; transform: translateY(8px); } 43%, 90% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; transform: none; } }
  @keyframes tr-press-ctrl { 0%, 17%, 24%, 100% { transform: none; background: var(--nfv-navy); color: var(--nfv-white); } 18%, 23% { transform: translateY(0.12em); background: var(--nfv-light-blue); color: var(--nfv-midnight); box-shadow: none; } }
  @keyframes tr-step-1 { 0%, 6%, 17%, 100% { background: var(--nfv-white); } 8%, 16% { background: var(--nfv-light-blue); } }
  @keyframes tr-step-2 { 0%, 17%, 39%, 100% { background: var(--nfv-white); } 18%, 37% { background: var(--nfv-light-blue); } }
  @keyframes tr-step-3 { 0%, 40%, 94%, 100% { background: var(--nfv-white); } 42%, 92% { background: var(--nfv-light-blue); } }

  /* ---- Pause button and reduced motion ---- */
  .motion-paused .demo *,
  .motion-paused .demo *::before { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .demo *, .demo *::before { animation: none !important; }
    .demo__toolbar, .pointer, .ibeam, .copy-demo .copied, .context-menu { display: none; }
    .paper__line span::before { transform: scaleX(1); }
    .copy-demo .doc-text__paste { max-height: none; }
    .translation { opacity: 1; transform: none; }
  }

  @media (max-width: 600px) {
    .windows { grid-template-columns: 1fr; }
    .demo-keys { font-size: 1.25rem; }
  }
</style>
{% endblock %}

{% macro pointer(class_="") -%}
<svg class="pointer {{ class_ }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 2.5v17l4.6-4.3 3 6.6 3-1.4-3-6.4h6.3z" fill="#231F20" stroke="#FFFFFF" stroke-width="1.5" stroke-linejoin="round"/></svg>
{%- endmacro %}

{% macro ibeam() -%}
<svg class="ibeam" viewBox="0 0 12 20" aria-hidden="true"><path d="M3 1.5c1.6 0 2.4.6 3 1.4.6-.8 1.4-1.4 3-1.4M3 18.5c1.6 0 2.4-.6 3-1.4.6.8 1.4 1.4 3 1.4M6 3v14M4 10h4" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/><path d="M3 1.5c1.6 0 2.4.6 3 1.4.6-.8 1.4-1.4 3-1.4M3 18.5c1.6 0 2.4-.6 3-1.4.6.8 1.4 1.4 3 1.4M6 3v14M4 10h4" fill="none" stroke="#231F20" stroke-width="1.3" stroke-linecap="round"/></svg>
{%- endmacro %}

{% macro window(title) -%}
<div class="win">
  <div class="win__bar"><i></i><i></i><i></i><span>{{ title }}</span></div>
  <div class="win__body">{{ caller() }}</div>
</div>
{%- endmacro %}

{% macro pause_button() -%}
<div class="demo__toolbar"><button type="button" class="motion-toggle" aria-pressed="false">Pause animations</button></div>
{%- endmacro %}

{% block content %}

{# ------------------------------------------------------------------ Hero #}
<section class="block" style="padding-top: 24px;">
  <span class="kicker">Issue {{ issue.number }} · This week's skill</span>
  {{ ui.headline("Text in a picture?", "Copy it like any other text.", tag="h1", class_="display") }}
  <p class="lede">
    Last week you took screenshots. This week, pull the words out of them. Live Text lets you
    select, copy, and translate the text in photos, screenshots, and scanned handouts, so you
    never have to retype it.
  </p>
  <hr class="rule">
</section>

{# ------------------------------------------------------------------ Copy #}
<section class="block">
  {{ ui.headline("Point, drag, copy.", "It works like a document.") }}
  <p>
    Open a photo or screenshot in Preview or Photos. Hold the pointer over the words, then drag
    across them to select, just like text in a document. Copy with {{ ui.combo("cmd C") }} and paste
    anywhere with {{ ui.combo("cmd V") }}.
  </p>

  <figure class="demo copy-demo" data-gif="copy-text-from-photo" data-gif-seconds="10" data-gif-start="0.8">
    <div class="demo__panel">
      {{ pause_button() }}
      <div class="windows" aria-hidden="true">
        {% call window("lab-safety.jpeg") %}
          <div class="photo">
            <div class="paper">
              <p class="paper__title">LAB SAFETY</p>
              <span class="paper__line"><span>Wear goggles at all times.</span></span>
              <span class="paper__line"><span>Tie back long hair.</span></span>
              <span class="paper__line"><span>Report spills right away.{{ ibeam() }}</span></span>
            </div>
          </div>
          <span class="badge badge--navy copied">Copied!</span>
        {% endcall %}
        {% call window("Untitled document") %}
          <p class="doc-text">
            Lab rules for Friday:
            <span class="doc-text__paste">Wear goggles at all times.<br>Tie back long hair.<br>Report spills right away.</span>
            <span class="paste-spot">{{ pointer("pointer--click") }}</span><span class="caret"></span>
          </p>
        {% endcall %}
      </div>
      <div class="demo-keys" aria-hidden="true">
        <span class="press-cmd">{{ ui.keycap(parse_combo("cmd")[0], show_name=true) }}</span>
        <span class="press-c">{{ ui.keycap(parse_combo("C")[0]) }}</span>
        <span class="press-v">{{ ui.keycap(parse_combo("V")[0]) }}</span>
      </div>
      <ol class="steps">
        <li><span>Drag across the words in the picture</span></li>
        <li><span>Press {{ ui.combo("cmd C") }} to copy</span></li>
        <li><span>Click in your document and press {{ ui.combo("cmd V") }}</span></li>
      </ol>
    </div>
    <figcaption>
      The words paste in as real text you can edit, format, and spell-check. No retyping.
    </figcaption>
  </figure>
</section>

{# ------------------------------------------------------------- Do more #}
<section class="block">
  {{ ui.headline("Do more than copy.", "Control-click the words.") }}
  <p>
    Select some text in a picture, then Control-click it (or click with two fingers on a trackpad).
    The menu has more than Copy Text:
  </p>
  <ul class="cards">
    <li class="card">
      <h3 style="margin-top: 0;">Translate</h3>
      <p>Choose Translate, then pick a language. Handy for a flyer, a sign, or a note written in another language.</p>
    </li>
    <li class="card">
      <h3 style="margin-top: 0;">Look up</h3>
      <p>Choose Look Up to see a definition or more information about a word or name.</p>
    </li>
    <li class="card">
      <h3 style="margin-top: 0;">Call, email, or open</h3>
      <p>Phone numbers, email addresses, and web addresses get a small arrow. Click it to call, write an email, or open the link.</p>
    </li>
  </ul>

  <figure class="demo translate-demo" data-gif="translate-text" data-gif-seconds="9" data-gif-start="0.6">
    <div class="demo__panel">
      {{ pause_button() }}
      <div class="windows windows--single" aria-hidden="true">
        {% call window("book-fair-flyer.jpeg") %}
          <div class="photo">
            <div class="paper">
              <p class="paper__title">FERIA DEL LIBRO</p>
              <span class="paper__line"><span>Jueves, 3:30 p.&nbsp;m.</span></span>
              <span class="paper__line"><span>Biblioteca de la escuela</span></span>
            </div>
          </div>
          {{ pointer("pointer--menu") }}
          <div class="context-menu">
            <span>Copy Text</span>
            <span>Look Up "Jueves, 3:30…"</span>
            <span class="menu-translate">Translate "Jueves, 3:30…"</span>
            <hr>
            <span>Search with Google</span>
          </div>
          <div class="translation">
            <p class="translation__langs">Spanish → English</p>
            <p class="translation__text">Thursday, 3:30 p.m.<br>School library</p>
          </div>
        {% endcall %}
      </div>
      <div class="demo-keys" aria-hidden="true">
        <span class="press-ctrl">{{ ui.keycap(parse_combo("ctrl")[0], show_name=true) }}</span>
      </div>
      <ol class="steps">
        <li><span>Select the words</span></li>
        <li><span>Hold {{ ui.combo("ctrl") }} and click, then choose Translate</span></li>
        <li><span>Read the translation and pick another language if you need one</span></li>
      </ol>
    </div>
    <figcaption>
      Translation is great for getting the gist. For important messages to families, have a fluent
      speaker check the wording before you send it.
    </figcaption>
  </figure>

  <aside class="callout">
    <span class="kicker">Not working?</span>
    <h3>Two settings to check</h3>
    <p>
      In Preview, choose <b>Tools → Text Selection</b>. If you still can't select the words, open
      <b>System Settings → General → Language &amp; Region</b> and turn on <b>Live Text</b>.
      Live Text doesn't recognize every language yet, so some text may not be selectable.
    </p>
  </aside>

  <aside class="callout">
    <span class="kicker">Before you share</span>
    <h3>Copied text is still student data</h3>
    <p>
      Text pulled from a photo of a sign-in sheet, a roster, or student work carries the same
      privacy rules as the original. Paste it only where you'd store the original, and leave names
      out of anything you share widely.
    </p>
  </aside>

  <div class="two-up">
    <aside class="callout">
      <span class="kicker">Try it this week</span>
      <h3>Rescue a printed handout</h3>
      <p>
        Have a handout with no digital copy? Snap a photo of it with your iPhone, AirDrop it to your
        Mac, open it in Preview, and copy the text into a new document. Five minutes instead of
        twenty spent retyping.
      </p>
    </aside>
    <aside class="callout">
      <span class="kicker">Classroom corner</span>
      <h3>Turn any page into text students can use</h3>
      <div class="key-row">
        {% for word, spanish in [("Copy text", "Copiar texto"), ("Translate", "Traducir"), ("Picture", "Imagen")] %}
        <figure>
          <figcaption>{{ word }}<span lang="es">{{ spanish }}</span></figcaption>
        </figure>
        {% endfor %}
      </div>
      <p>
        Once words from a printed page are real text, students can hear them read aloud with
        text-to-speech, enlarge them, or translate them into the language they know best. Every
        student gets to use the tools that help them read.
      </p>
    </aside>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
  // Pause / play every demo on the page (WCAG 2.2.2: moving content can be paused).
  const motionToggles = document.querySelectorAll(".motion-toggle");
  function setMotionPaused(paused) {
    document.body.classList.toggle("motion-paused", paused);
    motionToggles.forEach((button) => {
      button.setAttribute("aria-pressed", String(paused));
      button.textContent = paused ? "Play animations" : "Pause animations";
    });
  }
  motionToggles.forEach((button) =>
    button.addEventListener("click", () =>
      setMotionPaused(!document.body.classList.contains("motion-paused"))
    )
  );
</script>
{% endblock %}
