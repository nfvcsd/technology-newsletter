{% extends "email_base.html.j2" %}
{% import "email_macros.html.j2" as em %}
{% set sheet = cheatsheets["macos-shortcuts"] %}
{% set sheet_png = absolute("cheatsheets/" ~ sheet.slug ~ ".png") %}

{% block content %}

{# ------------------------------------------------------------------ Hero #}
{% call em.row("28px 28px 8px") %}
  {{ em.kicker("Issue " ~ issue.number ~ " · This week's skill") }}
  {{ em.headline("Stepping away?", "Lock it first.", size=28) }}
  {% call em.paragraph() %}
    A quick one for a short week. Locking your Mac takes one second and keeps student information
    private while you're away from your desk, whether that's five minutes or five days.
  {% endcall %}
  {{ em.rule() }}
{% endcall %}

{# ------------------------------------------------------------------ Lock #}
{% call em.row("28px 28px 32px") %}
  {{ em.headline("One move.", "Three ways to lock.") }}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% call em.shortcut("ctrl cmd Q", "Keyboard") %}The fastest way. Your screen locks the moment you press it.{% endcall %}
    {% call em.item("Apple menu") %}Click the Apple menu in the top-left corner of your screen, then choose <strong>Lock Screen</strong>.{% endcall %}
    {% call em.item("Touch ID") %}If your Mac or keyboard has Touch ID, press it once to lock. Some Magic Keyboards also have a Lock Screen key.{% endcall %}
  </table>
  <div style="height:20px;line-height:20px;font-size:20px;">&nbsp;</div>
  {{ em.image(absolute(gifs["lock-screen"]), "Animation: Control Command Q is pressed, the screen locks and hides an open gradebook, then a password unlocks it.", href=absolute(issue.filename)) }}
  {% set step_1 %}Press {{ em.combo("ctrl cmd Q") }}{% endset %}
  {{ em.steps([step_1, "Your screen locks and your work is hidden", "Back? Press any key and type your password, or use Touch ID"]) }}
  <div style="height:12px;line-height:12px;font-size:12px;">&nbsp;</div>
  {% call em.paragraph() %}
    Locking keeps everything open just as you left it. Nothing closes, and nothing is lost.
  {% endcall %}
{% endcall %}

{# ----------------------------------------------------------- Hot Corner #}
{% call em.row("0 28px 32px") %}
  {{ em.headline("Even faster.", "Flick to a corner.") }}
  {% call em.paragraph() %}
    A Hot Corner locks your Mac when you push the pointer into a corner of the screen. Set it up once:
  {% endcall %}
  {{ em.steps([
    "Open <strong>System Settings</strong> and click <strong>Desktop &amp; Dock</strong>." | safe,
    "Scroll down and click <strong>Hot Corners</strong>." | safe,
    "Pick a corner you don't use much, choose <strong>Lock Screen</strong> from its menu, and click <strong>Done</strong>." | safe,
  ]) }}
  <div style="height:20px;line-height:20px;font-size:20px;">&nbsp;</div>
  {{ em.image(absolute(gifs["hot-corner"]), "Animation: the pointer flicks into the top-right corner of the screen and the Mac locks.", href=absolute(issue.filename)) }}
  <div style="height:16px;line-height:16px;font-size:16px;">&nbsp;</div>
  {% call em.paragraph() %}
    Locking by accident? Hold {{ em.combo("cmd") }} while you choose Lock Screen in the Hot Corners
    menu. Then the corner works only while you hold Command.
  {% endcall %}
{% endcall %}

{# ------------------------------------------------------------ Callouts #}
{% call em.row("0 28px 16px") %}
  {% call em.callout("Set it and forget it", "Let your Mac lock itself") %}
    {% call em.paragraph() %}
      Open <strong>System Settings → Lock Screen</strong> and set <strong>Require password after
      screen saver begins or display is turned off</strong> to a short time. If you forget to lock,
      your Mac locks itself soon after the screen goes dark.
    {% endcall %}
  {% endcall %}
{% endcall %}

{% call em.row("0 28px 16px") %}
  {% call em.callout("Before break", "A 30-second checklist") %}
    {% call em.paragraph() %}
      Save and close anything with student information. If someone else uses your Mac, log out with
      {{ em.combo("shift cmd Q") }} instead of locking. Then lock your screen and enjoy the time off.
    {% endcall %}
  {% endcall %}
{% endcall %}

{% call em.row("0 28px 16px") %}
  {% call em.callout("Try it this week", "Make it a habit before break") %}
    {% call em.paragraph() %}
      Set up a Hot Corner today, then lock your Mac every time you leave the room this week. By
      Wednesday, you'll do it without thinking.
    {% endcall %}
  {% endcall %}
{% endcall %}

{% call em.row("0 28px 16px") %}
  {% call em.callout("Classroom corner", "\"Lock it when you leave it\"") %}
    {% call em.paragraph() %}
      Lock <span lang="es" style="color:{{ em.GRAY_9 }};">(bloquear)</span> &nbsp;·&nbsp;
      Password <span lang="es" style="color:{{ em.GRAY_9 }};">(contraseña)</span> &nbsp;·&nbsp;
      Screen <span lang="es" style="color:{{ em.GRAY_9 }};">(pantalla)</span>
    {% endcall %}
    {% call em.paragraph() %}
      Students take care of shared devices too. Teach the rhyme, practice {{ em.combo("ctrl cmd Q") }}
      once together, and let students remind each other.
    {% endcall %}
  {% endcall %}
{% endcall %}

{% call em.row("8px 28px 40px") %}
  {% call em.paragraph() %}
    {{ em.combo("ctrl cmd Q") }} is also on the <a href="{{ sheet_png }}" style="color:{{ em.NAVY }};">Mac cheat sheet from Issue 1</a>,
    in the Apps and windows section.
  {% endcall %}
{% endcall %}

{% endblock %}
